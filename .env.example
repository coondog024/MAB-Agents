# Anthropic API key for the agents (https://platform.claude.com). Never commit the real one.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# MAB_MODEL=claude-opus-5-5
# MAB_EFFORT=medium          # low | medium | high | xhigh | max
# MAB_FALLBACKS=1            # server-side refusal fallbacks on (1) / off (0)
# MAB_DB=mab.db              # SQLite file for repair orders
# MAB_SHOP=shop.toml         # shop profile
